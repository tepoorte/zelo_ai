
NODE_ENV=development
PORT=3041
AI_HOST=ai.zelo-epicerie.ch
AI_PORT=3041
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PLANNER_MODEL=llama3.2:1b

# Meta Webhooks (WhatsApp + Messenger)
META_VERIFY_TOKEN=changeme_verify
META_APP_SECRET=changeme_app_secret
META_GRAPH_TOKEN=EAAB... token pagina whatsapp
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# WhatsApp transport
# meta_cloud = official Meta webhook, web_session = WhatsApp Web via linked device.
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ADMIN_TOKEN=
WHATSAPP_SESSION_DIR=.cache/whatsapp-web-session
WHATSAPP_TEST_PHONE=41000000002
WHATSAPP_ALLOWED_PHONES=
WHATSAPP_AUTH_MODE=otp
WHATSAPP_OTP_TTL_MINUTES=10
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=90
WHATSAPP_SESSION_TTL_HOURS=336
ZELO_TEST_USERNAME=
ZELO_TEST_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# API Swissdata
SWISSDATA_BASE_URL=http://host.docker.internal:3040
SWISSDATA_API_KEY=PUBLICDEMO01
SWISSDATA_APP_ID=...         # se serve
SWISSDATA_SHOP_ID=000000000000000000000001
SWISSDATA_COUNTRY=CHE
SWISSDATA_ADMIN_TOKEN=
SWISSDATA_ADMIN_USERNAME=
SWISSDATA_ADMIN_PASSWORD=

# SMTP pour OTP WhatsApp et confirmation commande WhatsApp.
# En local avec le docker Swissdata: MailDev est exposé sur le host:2025.
SMTP_HOST=host.docker.internal
SMTP_PORT=2025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zelo AI <public-contact-002@example.invalid>"

APIKEY="PUBLICDEMO01"
SHOPID="000000000000000000000001"
TOKEN="00000000000000000000000000000000"

PROXYNET=traefik-net
CERTRESOLVER=mint-le

# Hub docker Mintello
DOCKERREGISTRY=hub.mintello.com
IMAGENAME=ai-zelo
VERSION=latest
DOCKERUSERNAME=
DOCKERPASSWORD=

#----------------------------------------------------------------------------------------------------------

TWILIO_SWISSDATA_USERNAME=
TWILIO_SWISSDATA_PASSWORD=
