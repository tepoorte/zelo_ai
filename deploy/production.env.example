NODE_ENV=production
PORT=3041

# Public host served by Traefik.
AI_HOST=assistant.zelo-epicerie.ch
AI_PORT=3041

# Current code path uses Ollama directly.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PLANNER_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Real Swissdata production API.
SWISSDATA_BASE_URL=https://api.zelo-epicerie.ch
SWISSDATA_API_KEY=PUBLICDEMO01
SWISSDATA_APP_ID=
SWISSDATA_SHOP_ID=000000000000000000000001
SWISSDATA_COUNTRY=CHE

# Optional integrations.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ADMIN_TOKEN=
WHATSAPP_SESSION_DIR=.cache/whatsapp-web-session
WHATSAPP_TEST_PHONE=
WHATSAPP_ALLOWED_PHONES=
WHATSAPP_AUTH_MODE=otp
WHATSAPP_OTP_TTL_MINUTES=10
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=90
WHATSAPP_SESSION_TTL_HOURS=336
WHATSAPP_ONBOARDING_URL=https://assistant.zelo-epicerie.ch/inscription-whatsapp
WHATSAPP_ONBOARDING_TTL_MINUTES=30
WHATSAPP_ONBOARDING_MAX_ATTEMPTS=5
WHATSAPP_ONBOARDING_LOCK_MINUTES=15
# Required in production. Generate outside Git: openssl rand -base64 32
WHATSAPP_ONBOARDING_STATE_KEY=
SWISSDATA_ADMIN_TOKEN=
SWISSDATA_ADMIN_USERNAME=
SWISSDATA_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OPENAI_API_KEY=

# Existing production Traefik values observed on the server.
PROXYNET=traefik-net
CERTRESOLVER=p5

# Docker image used by docker-compose.yml.
DOCKERREGISTRY=hub.mintello.com
IMAGENAME=ai-zelo
VERSION=<VERSION_PUSHED>

# Local build credentials only. Do not commit real values.
DOCKERUSERNAME=
DOCKERPASSWORD=

# Optional legacy/test fields.
APIKEY=PUBLICDEMO01
SHOPID=000000000000000000000001
TOKEN=
TWILIO_SWISSDATA_USERNAME=
TWILIO_SWISSDATA_PASSWORD=
